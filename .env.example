# Daily Task Logger — Environment Configuration
# Copy this file to .env to customize settings

# Host Port (e.g. 3000, 8080, 80)
PORT=3000

# (Optional) Google Apps Script Web App URL to write tasks directly into Google Sheets
# e.g. https://script.google.com/macros/s/AKfycb.../exec
# If left blank, entries will be stored locally in ./data/
SPREADSHEET_WEBAPP_URL=

# Default Timezone for timestamps (Default: Asia/Jakarta)
DEFAULT_TIMEZONE=Asia/Jakarta

# Default Engineer PIC name
DEFAULT_ENGINEER=Network Engineer
