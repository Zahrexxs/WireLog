{
  "name": "wirelog",
  "version": "1.0.0",
  "description": "Ergonomic, desktop-first web app for network engineers logging daily tasks directly into Google Sheets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/unitTests.js && node tests/serverTests.js",
    "test:unit": "node tests/unitTests.js",
    "test:server": "node tests/serverTests.js",
    "build": "node scripts/build.js",
    "serve": "node scripts/build.js && node server.js",
    "docker:build": "docker build -t wirelog .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "google-apps-script",
    "network-engineering",
    "task-logger",
    "google-sheets"
  ],
  "author": "Zahrexxs",
  "license": "MIT"
}
