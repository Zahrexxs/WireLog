{
  "name": "daily-task-logger",
  "version": "1.0.0",
  "description": "Lightweight, mobile-first Google Apps Script web app for logging network engineering daily tasks",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/unitTests.js",
    "build": "node scripts/build.js",
    "serve": "node scripts/build.js && node server.js",
    "docker:build": "docker build -t daily-task-logger .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "google-apps-script",
    "network-engineering",
    "task-logger",
    "google-sheets"
  ],
  "author": "Zahrexxs",
  "license": "MIT"
}
